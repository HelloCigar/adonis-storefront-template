{
  "name": "nuxt-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretypecheck": "node --input-type=module -e \"import { resolveConfig } from 'vite'; await resolveConfig({}, 'serve')\"",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --project inertia/tsconfig.json"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/luxon": "^3.7.1",
    "@types/node": "~25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.2",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.3.3",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.3",
    "@iconify-json/lucide": "^1.2.116",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/vue3": "^3.7.1",
    "@jrmc/adonis-attachment": "^6.0.0-beta.1",
    "@nuxt/ui": "^4.9.0",
    "@tuyau/core": "^1.2.2",
    "@unovis/vue": "^1.7.0",
    "@vinejs/vine": "^4.4.0",
    "@vue/server-renderer": "^3.5.43",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.4.0",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "@swc/core@1.15.47": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.27.7": true
  }
}
