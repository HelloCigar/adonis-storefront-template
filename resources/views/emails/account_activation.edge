@emailLayout({ title })
  <mj-section>
    <mj-column>
      <mj-text mj-class="title">Welcome to {{ brandName }} - just one more step!</mj-text>
      <mj-spacer height="30px" />
      <mj-text mj-class="text">
        To get started, we need to confirm your email address, so please click this link to finish creating your account:
      </mj-text>
      <mj-spacer height="15px" />
      <mj-button href="{{ verificationLink }}">Verify your email address</mj-button>
      <mj-spacer height="15px" />
      <mj-text mj-class="help">
        If you didn't request this email, there's no need to worry. You can safely ignore it.
      </mj-text>
      <mj-spacer height="15px" />
      <mj-divider />
    </mj-column>
  </mj-section>
@end
