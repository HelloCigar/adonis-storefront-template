@mjml()
  <mjml>
    <mj-head>
      <mj-preview>{{ title }}</mj-preview>
      <mj-title>{{ title }}</mj-title>
      <mj-attributes>
        <mj-text padding="0" color="#202020" />
        <mj-divider padding="0" border-width="2px" border-color="#cecece" />
        <mj-button padding="0" align="left" />
        <mj-class name="title" font-size="28px" font-weight="600" />
        <mj-class name="text" font-size="16px" line-height="22px" />
        <mj-class name="help" font-size="14px" line-height="18px" color="#646464" />
        <mj-class name="footer" font-size="14px" line-height="18px" color="#8d8d8d" />
        <mj-all font-family="Arial" />
      </mj-attributes>
    </mj-head>
    <mj-body>{{{ await $slots.main() }}}</mj-body>
  </mjml>
@end
