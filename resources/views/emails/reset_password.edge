@emailLayout({ title, brandName })
  <mj-section>
    <mj-column>
      <mj-text mj-class="title">Need a new password?</mj-text>
      <mj-spacer height="12px" />
      <mj-text mj-class="text">
        Someone recently requested a password change for your {{ brandName }} account. If this were you, you could set a new password here:
      </mj-text>
      <mj-spacer height="24px" />
      <mj-button href="{{ passwordResetLink }}">Reset password</mj-button>
      <mj-spacer height="24px" />
      <mj-text mj-class="help">
        If you don't want to change your password or didn't request this change, simply ignore and delete this message.
      </mj-text>
      <mj-spacer height="8px" />
      <mj-text mj-class="help">
        To keep your account secure, please don't forward this email to anyone.
      </mj-text>
      <mj-spacer height="24px" />
      <mj-text mj-class="help">
        If the button doesn't work, copy this link into your browser:<br />
        <a href="{{ passwordResetLink }}" class="link">{{ passwordResetLink }}</a>
      </mj-text>
      <mj-spacer height="32px" />
      <mj-divider />
      <mj-spacer height="16px" />
      <mj-text mj-class="footer">
        You're receiving this email because a password change was requested for your {{ brandName }} account.
      </mj-text>
    </mj-column>
  </mj-section>
@end
