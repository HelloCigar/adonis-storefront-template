# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Persistent directory for db.sqlite3 and attachments/ in production (defaults to tmp/ and storage/)
# DATA_DIR=
# Trust one reverse-proxy hop for client IPs (set to true on Railway)
# TRUST_PROXY=false

# Session
SESSION_DRIVER=cookie
QUEUE_DRIVER=database

# Rate limits shared by web processes (memory is process-local; tests only)
LIMITER_STORE=database

# Use fake_paymongo for local checkout simulation; production requires paymongo.
# PayMongo (server-side secret API key and this endpoint's webhook secret)
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
PAYMONGO_TIMEOUT_MS=15000
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

# SMTP (Mailpit locally; configure a real transport before production)
MAIL_MAILER=smtp
MAIL_FROM_NAME=MediaBunny
MAIL_FROM_ADDRESS=store@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=